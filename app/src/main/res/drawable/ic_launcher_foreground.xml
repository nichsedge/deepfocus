<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glow Ring (Indigo to Emerald gradient) -->
    <path
        android:pathData="M 54, 54 m -38, 0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0"
        android:strokeWidth="2"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="16"
                android:startY="16"
                android:endX="92"
                android:endY="92"
                android:type="linear">
                <item android:color="#6366F1" android:offset="0.0" />
                <item android:color="#10B981" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Subtle Accent Ring -->
    <path
        android:pathData="M 54, 54 m -30, 0 a 30,30 0 1,1 60,0 a 30,30 0 1,1 -60,0"
        android:strokeWidth="1"
        android:strokeColor="#15FFFFFF"
        android:fillColor="#00000000" />

    <!-- Sand (Bottom Bulb - Emerald green pile) -->
    <path
        android:pathData="M 40.5,70 C 45.5,64.5 62.5,64.5 67.5,70 Z"
        android:fillColor="#10B981" />

    <!-- Hourglass Body Outline (Semi-transparent white) -->
    <path
        android:pathData="M 40,36 C 40,47 50,51 50,54 C 50,57 40,61 40,72 H 68 C 68,61 58,57 58,54 C 58,51 68,47 68,36 Z"
        android:strokeWidth="2"
        android:strokeColor="#E2E8F0"
        android:fillColor="#0FFFFFFF" />

    <!-- Top & Bottom Plates (Solid Slate/White) -->
    <path
        android:pathData="M 36,36 L 72,36 M 36,72 L 72,72"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

</vector>